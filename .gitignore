# Entorno del proyecto — generado por el agente, no por la app

# Herramientas y cachés locales de desarrollo (intérprete Python, venv, cargo, uv)
.tooling/

# Rust
target/
# Variantes usadas para no invalidar la caché de compilación al cambiar de
# features (target-tests, target-tts): suman varios GB.
target-*/

# Node
node_modules/
dist/
dist-ssr/
*.local

# ZIP de la release (lo arma scripts/empaquetar-release.ps1)
dist-release/

# Salidas de Tauri (un patron con barra ancla a la raiz: hace falta **/)
**/src-tauri/target/
**/src-tauri/gen/
# Tauri externalBin: se genera con scripts/build-tts-sidecar.ps1 y no se
# versiona el ejecutable congelado.
**/src-tauri/binaries/*
!**/src-tauri/binaries/.gitkeep

# Datos y logs en tiempo de ejecución (nunca versionar)
data/
logs/
cache/
backup/

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# Python: bytecode de las herramientas del spike (dump_proto.py y compania)
__pycache__/
*.pyc
