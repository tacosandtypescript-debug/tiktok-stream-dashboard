{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTokStreamDashboard",
  "version": "0.1.0",
  "identifier": "com.isaac.tiktokstreamdashboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TikTok LIVE Dashboard",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/tiktok-tts-provider"],
    "licenseFile": "../../../LICENSE",
    "resources": ["../../../THIRD_PARTY_NOTICES.md"]
  }
}
